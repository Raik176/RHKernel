# Base style
BasedOnStyle: Google

# Indentation
IndentWidth: 4
ColumnLimit: 100

# Namespace handling
NamespaceIndentation: All

# Braces and Spacing
BreakBeforeBraces: Custom
BraceWrapping:
  AfterClass: false
  AfterControlStatement: Never
  AfterFunction: false
  AfterNamespace: false
  AfterStruct: false
  BeforeElse: false

# Keep short blocks on one line (for your hex_to_int logic)
AllowShortBlocksOnASingleLine: Always
AllowShortIfStatementsOnASingleLine: WithoutElse
AllowShortLoopsOnASingleLine: true

# Pointer alignment
PointerAlignment: Right

# Doxygen comments
CommentPragmas: '^ @brief'