KCODE_SEL  equ 0x08  ; Kernel code segment, RPL 0
KDATA_SEL  equ 0x10  ; Kernel data segment, RPL 0
UDATA32_SEL equ 0x18 | 3 ; User data 32-bit, RPL 3
UCODE32_SEL equ 0x20 | 3 ; User code 32-bit, RPL 3
UDATA64_SEL equ 0x28 | 3 ; User data 64-bit, RPL 3
UCODE64_SEL equ 0x30 | 3 ; User code 64-bit, RPL 3
TSS_SEL    equ 0x38  ; TSS selector (16 bytes, uses entries 7 & 8)